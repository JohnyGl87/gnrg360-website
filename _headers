# Cloudflare Pages custom headers.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# Unlisted files, hosted only so they have a stable public URL (email-signature images).
# Not linked from anywhere on the site; noindex keeps them out of search engines.
/assets/medly-signature-logo.png
  X-Robots-Tag: noindex, noimageindex, nofollow
  Cache-Control: public, max-age=604800

/assets/nrg-signature-logo.png
  X-Robots-Tag: noindex, noimageindex, nofollow
  Cache-Control: public, max-age=604800
